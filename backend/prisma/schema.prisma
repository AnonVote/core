generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id           String            @id @default(uuid())
  name         String            @unique
  email        String
  passwordHash String
  createdAt    DateTime          @default(now())
  /// X25519 raw public key, base64. Null until the browser enrolls one.
  publicKey         String?
  /// 16 random bytes, base64. Server-generated at registration; public.
  keyDerivationSalt String?
  keyVersion        Int          @default(1)
  sessions     Session[]
  ballots      Ballot[]
  keys         OrganizationKey[]
  auditEvents  AuditEvent[]
}

model Session {
  id             String       @id @default(uuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
}

model Ballot {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  topic             String
  status            BallotStatus    @default(DRAFT)
  deadline          DateTime
  startTime         DateTime?
  eligibilityListId String
  eligibilityList   EligibilityList @relation(fields: [eligibilityListId], references: [id])
  allowWeightedVoting Boolean       @default(false)
  allowRankedChoice Boolean       @default(false)
  maxRankings       Int?           // Max number of rankings allowed (for ranked-choice)
  autoFinalise      Boolean         @default(false)
  optionCount       Int             @default(0)
  createdAt         DateTime        @default(now())
  deletedAt         DateTime?
  options           Option[]
  votes             Vote[]
  result            Result?
  auditEvents       AuditEvent[]
  stellarTxId       String?
  anchorStatus      AnchorStatus    @default(PENDING)
  tokenDeliveryRetries TokenDeliveryRetry[]
  ballotKey         BallotKey?
  anchorRetries     BallotAnchorRetry[]
  /// "v1:ephPub:iv:ct" — null means no description (incl. all legacy ballots).
  descriptionCiphertext String?
  descriptionKeyVersion Int?
  /// sha256 hex of the description PLAINTEXT, computed in the browser.
  /// The commitment covers this, not the ciphertext: re-encryption (e.g. on a
  /// password change) mints a fresh envelope for identical content, which would
  /// otherwise invalidate an already-anchored, write-once commitment forever.
  descriptionHash       String?
  /// sha256 hex over the canonical payload (topic, description ct, options, deadline).
  commitmentHash        String?
  commitmentTxId        String?
  commitmentAnchoredAt  DateTime?
}

enum BallotStatus {
  DRAFT
  ACTIVE
  CLOSED
  FINALISED
}

enum AnchorStatus {
  PENDING
  ANCHORED
  FAILED
}

model Option {
  id       String @id @default(uuid())
  ballotId String
  ballot   Ballot @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  text     String
}

model EligibilityList {
  id        String             @id @default(uuid())
  createdAt DateTime           @default(now())
  entries   EligibilityEntry[]
  ballots   Ballot[]
}

model EligibilityEntry {
  id                String          @id @default(uuid())
  eligibilityListId String
  eligibilityList   EligibilityList @relation(fields: [eligibilityListId], references: [id])
  identifierHash    String
  weight            Int             @default(1)
  tokenIssued       Boolean         @default(false)

  @@unique([eligibilityListId, identifierHash])
}

model VoterToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  ballotId      String
  used          Boolean   @default(false)
  issuedAt      DateTime  @default(now())
  usedAt        DateTime?
  delegatedFrom String? // If set, this token was delegated to by another token
  delegatedTo   String? // If set, this token delegates its vote to another token
  deliveryRetry TokenDeliveryRetry?
}

model BallotKey {
  id        String   @id @default(uuid())
  ballotId  String   @unique
  ballot    Ballot   @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  key       String
  previousKey String?
  rotatedAt DateTime?
  createdAt DateTime @default(now())

  @@map("ballot_keys")
}

model Vote {
  id              String             @id @default(uuid())
  ballotId        String
  ballot          Ballot             @relation(fields: [ballotId], references: [id])
  encryptedOption String             @map("encrypted_option")
  weight          Int                @default(1)
  rank            Int?               // For ranked-choice: 1 = first choice, 2 = second, etc.
  stellarTxId     String?            @map("stellar_tx_id")
  sorobanTxId     String?            @map("soroban_tx_id")
  anchorStatus    AnchorStatus       @default(PENDING) @map("anchor_status")
  submittedAt     DateTime           @default(now())
  retryQueue      StellarRetryQueue?
}

model StellarRetryQueue {
  id         String   @id @default(uuid())
  voteId     String   @unique @map("vote_id")
  vote       Vote     @relation(fields: [voteId], references: [id], onDelete: Cascade)
  retryCount Int      @default(0) @map("retry_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("stellar_retry_queue")
}

model BallotAnchorRetry {
  id         String   @id @default(uuid())
  ballotId   String   @unique
  ballot     Ballot   @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ballot_anchor_retry_queue")
}

model Result {
  id              String    @id @default(uuid())
  ballotId        String    @unique
  ballot          Ballot    @relation(fields: [ballotId], references: [id])
  tallyJson       String
  totalVotes      Int
  isConsistent    Boolean
  stellarTxId     String?
  stellarLedgerAt DateTime? // Stellar network consensus timestamp
  sorobanTxId     String?   // Soroban contract record_result tx hash
  verifiedOnChain Boolean?  // Result of post-finalisation Soroban is_consistent() check (null = not yet checked)
  finalised       Boolean   @default(false)
  finalisedAt     DateTime?
  publishedAt     DateTime  @default(now())
}

model AuditEvent {
  id              String         @id @default(uuid())
  ballotId        String
  ballot          Ballot         @relation(fields: [ballotId], references: [id])
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  eventType       AuditEventType
  stellarTxId     String?
  stellarLedgerAt DateTime? // Stellar network consensus timestamp
  createdAt       DateTime       @default(now())
  /// Encrypted snapshot of what changed; readable only by the owning org.
  metadataCiphertext String?

  @@index([organizationId])
}

model TokenDeliveryRetry {
  id                 String          @id @default(uuid())
  ballotId           String
  voterTokenId       String          @unique
  recipientEncrypted String
  attempts           Int             @default(0)
  nextAttemptAt      DateTime        @default(now())
  lastError          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  ballot            Ballot          @relation(fields: [ballotId], references: [id])
  voterToken        VoterToken      @relation(fields: [voterTokenId], references: [id])
}

enum AuditEventType {
  TOKEN_ISSUED
  TOKEN_DELIVERY_FAILED
  VOTE_CAST
  RESULT_PUBLISHED
  DUPLICATE_TOKEN_ATTEMPT
  DUPLICATE_VOTE_ATTEMPT
  RATE_LIMIT_EXCEEDED
  BALLOT_METADATA_CHANGED
}

/// Persisted rate-limit counters — survives server restarts.
/// key format: "ip:<ip>", "ballot:<ballotId>", "token:<tokenHash>"
model RateLimitEntry {
  id          String   @id @default(uuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Per-organization encryption keys for vote data isolation
/// Each organization has its own key encrypted by a master key
model OrganizationKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyVersion     Int          @default(1)
  encryptedKey   String // Key encrypted with master key
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  rotatedAt      DateTime?

  @@unique([organizationId, keyVersion])
  @@index([organizationId, isActive])
}

model ReissueRateLimit {
  id             String   @id @default(uuid())
  identifierHash String   @unique @map("identifier_hash")
  attempts       Int      @default(1)
  windowStart    DateTime @default(now()) @map("window_start")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("reissue_rate_limits")
}

