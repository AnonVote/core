generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id           String            @id @default(uuid())
  name         String            @unique
  email        String
  passwordHash String
  createdAt    DateTime          @default(now())
  sessions     Session[]
  ballots      Ballot[]
  keys         OrganizationKey[]
  auditEvents  AuditEvent[]
}

model Session {
  id             String       @id @default(uuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
}

model Ballot {
  id                  String          @id @default(uuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id])
  topic               String
  status              BallotStatus    @default(OPEN)
  deadline            DateTime
  eligibilityListId   String
  eligibilityList     EligibilityList @relation(fields: [eligibilityListId], references: [id])
  allowWeightedVoting Boolean         @default(false)
  allowRankedChoice   Boolean         @default(false)
  maxRankings         Int? // Max number of rankings allowed (for ranked-choice)
  createdAt           DateTime        @default(now())
  options             Option[]
  votes               Vote[]
  result              Result?
  auditEvents         AuditEvent[]
}

enum BallotStatus {
  OPEN
  CLOSED
}

model Option {
  id       String @id @default(uuid())
  ballotId String
  ballot   Ballot @relation(fields: [ballotId], references: [id])
  text     String
  votes    Vote[]
}

model EligibilityList {
  id        String             @id @default(uuid())
  createdAt DateTime           @default(now())
  entries   EligibilityEntry[]
  ballots   Ballot[]
}

model EligibilityEntry {
  id                String          @id @default(uuid())
  eligibilityListId String
  eligibilityList   EligibilityList @relation(fields: [eligibilityListId], references: [id])
  identifierHash    String
  weight            Int             @default(1)
  tokenIssued       Boolean         @default(false)

  @@unique([eligibilityListId, identifierHash])
}

model VoterToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  ballotId      String
  used          Boolean   @default(false)
  issuedAt      DateTime  @default(now())
  usedAt        DateTime?
  delegatedFrom String? // If set, this token was delegated to by another token
  delegatedTo   String? // If set, this token delegates its vote to another token
}

model Vote {
  id               String   @id @default(uuid())
  ballotId         String
  ballot           Ballot   @relation(fields: [ballotId], references: [id])
  optionId         String
  option           Option   @relation(fields: [optionId], references: [id])
  encryptedPayload String
  weight           Int      @default(1)
  rank             Int? // For ranked-choice: 1 = first choice, 2 = second, etc.
  stellarTxId      String?
  submittedAt      DateTime @default(now())
}

model Result {
  id              String    @id @default(uuid())
  ballotId        String    @unique
  ballot          Ballot    @relation(fields: [ballotId], references: [id])
  tallyJson       String
  totalVotes      Int
  isConsistent    Boolean
  stellarTxId     String?
  stellarLedgerAt DateTime? // Stellar network consensus timestamp
  publishedAt     DateTime  @default(now())
}

model AuditEvent {
  id              String         @id @default(uuid())
  ballotId        String
  ballot          Ballot         @relation(fields: [ballotId], references: [id])
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  eventType       AuditEventType
  stellarTxId     String?
  stellarLedgerAt DateTime? // Stellar network consensus timestamp
  createdAt       DateTime       @default(now())

  @@index([organizationId])
}

enum AuditEventType {
  TOKEN_ISSUED
  VOTE_CAST
  RESULT_PUBLISHED
  DUPLICATE_TOKEN_ATTEMPT
  DUPLICATE_VOTE_ATTEMPT
  RATE_LIMIT_EXCEEDED
}

/// Persisted rate-limit counters — survives server restarts.
/// key format: "ip:<ip>", "ballot:<ballotId>", "token:<tokenHash>"
model RateLimitEntry {
  id          String   @id @default(uuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Per-organization encryption keys for vote data isolation
/// Each organization has its own key encrypted by a master key
model OrganizationKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyVersion     Int          @default(1)
  encryptedKey   String // Key encrypted with master key
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  rotatedAt      DateTime?

  @@unique([organizationId, keyVersion])
  @@index([organizationId, isActive])
}
