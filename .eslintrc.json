{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.ts", "src/**/*.test.ts", "src/**/*.spec.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
